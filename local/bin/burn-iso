#!/bin/bash

set -e

command -v fzf >/dev/null 2>&1 || { echo "Error: fzf is required."; exit 1; }
command -v gum >/dev/null 2>&1 || { echo "Error: gum is required."; exit 1; }

wait_to_close() {
    read -r -p $'\nPress Enter to close...' || true
}
trap wait_to_close EXIT

pick_iso() {
    gum style "Select an ISO image:" --bold >&2
    local iso
    iso=$(find "${ISO_DIR:-$HOME/Downloads}" /tmp . -maxdepth 2 -iname '*.iso' -type f 2>/dev/null \
        | fzf --prompt="ISO > " --height=40% \
        || true)
    [ -n "$iso" ] && echo "$iso"
}

pick_device() {
    gum style "Select the USB device:" --bold >&2
    gum style "Device / Size / Label / Mountpoint" --faint >&2
    local dev
    dev=$(lsblk -rnpo NAME,SIZE,LABEL,MOUNTPOINT -e7,11 | \
        fzf --prompt="Device > " --height=40% \
        || true)
    echo "${dev%% *}"
}

device_info() {
    lsblk -rnpo NAME,SIZE,LABEL,MOUNTPOINT "$1" -e7,11 | tr -s ' '
}

ISO=$(pick_iso) || exit 1
[ -z "$ISO" ] && { gum style "No ISO selected. Aborted." --foreground=red; exit 1; }

DEVICE=$(pick_device) || exit 1
[ -z "$DEVICE" ] && { gum style "No device selected. Aborted." --foreground=red; exit 1; }

[ -b "$DEVICE" ] || { gum style "Not a block device: $DEVICE" --foreground=red; exit 1; }

gum style --border rounded --padding "1 2" \
    "ISO:    $ISO" \
    "Device: $(device_info "$DEVICE")"

gum style "WARNING: $DEVICE will be completely overwritten!" --foreground=yellow --bold
gum confirm "Continue?" || { gum style "Aborted." --foreground=yellow; exit 1; }

gum style "Burning ISO..." --bold

total=$(stat -c%s "$ISO")
bar_width=50

draw_bar() {
    local pct=$1 i bar=""
    for ((i = 0; i < bar_width; i++)); do
        ((i < pct * bar_width / 100)) && bar+="█" || bar+="░"
    done
    printf "\r\033[K%s %3d%%" "$bar" "$pct"
}

sudo dd if="$ISO" of="$DEVICE" bs=4M status=progress conv=fsync 2>&1 \
    | while IFS= read -r line; do
        case "$line" in
            *" bytes "*" copied,"*) draw_bar "$(( ${line%% *} * 100 / total ))";;
        esac
    done
status=${PIPESTATUS[0]}
printf "\n"
[ "$status" -eq 0 ] || { gum style "Burn failed (dd exit $status)." --foreground=red; exit 1; }

gum style "Done. Safely unplug the USB." --foreground=green --bold
