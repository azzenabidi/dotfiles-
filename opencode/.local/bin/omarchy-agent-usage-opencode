#!/usr/bin/python3
"""Collect opencode usage into one display-ready JSON record.

Reads the opencode SQLite database read-only and writes a record matching
the omarchy agents panel contract. The panel discovers any *.json in
~/.local/state/omarchy/agents/usage, so this collector runs on its own
schedule (systemd user timer) and the watcher picks up each rewrite.
"""

from __future__ import annotations

import datetime as dt
import json
import os
import sqlite3
import sys
import tempfile
from pathlib import Path
from typing import Any

AGENT_ID = "opencode"
AGENT_NAME = "OpenCode"


def expand_path(value: str) -> Path:
  return Path(os.path.expandvars(os.path.expanduser(value))).resolve()


def usage_dir() -> Path:
  state = os.environ.get("XDG_STATE_HOME") or (Path.home() / ".local" / "state")
  return Path(state) / "omarchy" / "agents" / "usage"


def date_string(value: dt.date) -> str:
  return value.strftime("%Y-%m-%d")


def recent_date_strings() -> list[str]:
  today = dt.datetime.now().date()
  return [date_string(today - dt.timedelta(days=offset)) for offset in range(6, -1, -1)]


def local_date_from_ts_ms(value: Any) -> str:
  try:
    return date_string(dt.datetime.fromtimestamp(float(value) / 1000.0).date())
  except Exception:
    return date_string(dt.datetime.now().date())


def number(value: Any) -> int:
  try:
    n = float(value or 0)
    return round(n) if n == n else 0
  except Exception:
    return 0


def empty_bucket() -> dict[str, int]:
  return {
    "inputTokens": 0,
    "outputTokens": 0,
    "cacheReadInputTokens": 0,
    "cacheCreationInputTokens": 0,
  }


def model_usage_key(model_json: Any) -> str:
  parsed = model_json
  if isinstance(model_json, str):
    try:
      parsed = json.loads(model_json)
    except Exception:
      parsed = None
  if isinstance(parsed, dict):
    value = str(parsed.get("id") or "")
    if value:
      return value.rstrip("/").split("/")[-1]
  return AGENT_ID


def collect(db_path: Path) -> dict[str, Any]:
  today = local_date_from_ts_ms(dt.datetime.now().timestamp() * 1000)
  recent_dates = recent_date_strings()
  recent = {day: {"date": day, "messageCount": 0} for day in recent_dates}

  sessions: set[str] = set()
  active_days: set[str] = set()
  today_sessions: set[str] = set()
  today_tokens: dict[str, int] = {}
  usage_by_model: dict[str, dict[str, int]] = {}
  prompts = 0
  today_prompt_count = 0
  today_token_total = 0

  try:
    conn = sqlite3.connect(db_path.resolve().as_uri() + "?mode=ro", uri=True, timeout=2)
  except sqlite3.Error as exc:
    print(f"Could not open opencode database {db_path}: {exc}", file=sys.stderr)
    return {}

  try:
    conn.execute("PRAGMA query_only = ON")

    # The session table is authoritative for tokens; message-level token
    # fields are zeroed by local models.
    for session_id, created_ms, raw_model, input_tokens, output_tokens, reasoning, cache_read, cache_write in conn.execute(
        "SELECT id, time_created, model, tokens_input, tokens_output, "
        "tokens_reasoning, tokens_cache_read, tokens_cache_write FROM session"
    ):
      input_tokens = number(input_tokens)
      output_tokens = number(output_tokens)
      reasoning = number(reasoning)
      cache_read = number(cache_read)
      cache_write = number(cache_write)
      total = input_tokens + output_tokens + reasoning + cache_read + cache_write

      day = local_date_from_ts_ms(created_ms)
      sessions.add(str(session_id))
      active_days.add(day)

      bucket = usage_by_model.setdefault(model_usage_key(raw_model), empty_bucket())
      bucket["inputTokens"] += input_tokens
      # Thinking tokens are generated output; keep them with output for the
      # model row, matching how other opencode scanners account for them.
      bucket["outputTokens"] += output_tokens + reasoning
      bucket["cacheReadInputTokens"] += cache_read
      bucket["cacheCreationInputTokens"] += cache_write

      if day in recent:
        recent[day]["messageCount"] += total
      if day == today:
        today_token_total += total
        model = model_usage_key(raw_model)
        today_tokens[model] = today_tokens.get(model, 0) + total

    # Prompts are user-role messages; their timestamp lives in the message
    # payload rather than a column.
    for session_id, created_ms in conn.execute(
        "SELECT session_id, json_extract(data, '$.time.created') FROM message "
        "WHERE json_extract(data, '$.role') = 'user'"
    ):
      prompts += 1
      day = local_date_from_ts_ms(created_ms)
      if day == today:
        today_prompt_count += 1
        today_sessions.add(str(session_id))
  except sqlite3.Error as exc:
    print(f"Could not scan opencode database {db_path}: {exc}", file=sys.stderr)
    return {}
  finally:
    conn.close()

  return {
    "todayPrompts": today_prompt_count,
    "todaySessions": len(today_sessions),
    "todayTotalTokens": today_token_total,
    "todayTokensByModel": today_tokens,
    "recentDays": [recent[day] for day in recent_dates],
    "modelUsage": usage_by_model,
    "totalPrompts": prompts,
    "totalSessions": len(sessions),
    "activeDays": len(active_days),
    "activeDates": sorted(active_days),
  }


def write_json(path: Path, payload: dict[str, Any]) -> None:
  handle_fd, tmp_name = tempfile.mkstemp(dir=path.parent, prefix=path.name + ".", suffix=".tmp")
  tmp = Path(tmp_name)
  try:
    with os.fdopen(handle_fd, "w", encoding="utf-8") as handle:
      handle.write(json.dumps(payload, separators=(",", ":"), sort_keys=True) + "\n")
    tmp.chmod(0o644)
    tmp.replace(path)
  except BaseException:
    tmp.unlink(missing_ok=True)
    raise


def main() -> int:
  db_path = Path(os.environ.get("XDG_DATA_HOME") or (Path.home() / ".local" / "share")) / "opencode" / "opencode.db"
  if not db_path.is_file():
    return 0

  stats = collect(db_path)
  if not stats:
    return 0

  record = {
    "schemaVersion": 1,
    "id": AGENT_ID,
    "name": AGENT_NAME,
    "providerId": AGENT_ID,
    "scope": "device",
    "updatedAt": dt.datetime.now(dt.timezone.utc).isoformat(),
    "ready": True,
    "hasLocalStats": True,
    "hasPromptStats": True,
  }
  record.update(stats)

  out_path = usage_dir() / (AGENT_ID + ".json")
  try:
    out_path.parent.mkdir(parents=True, exist_ok=True)
    write_json(out_path, record)
  except OSError as exc:
    print(f"Could not write usage record {out_path}: {exc}", file=sys.stderr)
    return 1

  print(json.dumps(record, separators=(",", ":"), sort_keys=True))
  return 0


if __name__ == "__main__":
  raise SystemExit(main())
